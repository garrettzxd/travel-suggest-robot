{
  "name": "@travel/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -b && (trap 'kill 0' EXIT INT TERM; tsc -b -w --preserveWatchOutput & dotenv -e ../../.env -- node --watch dist/index.js)",
    "build": "tsc -b",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "typecheck": "tsc --noEmit",
    "ping:llm": "tsc -b && dotenv -e ../../.env -- node dist/scripts/ping-llm.js",
    "ping:weather": "tsc -b && AMAP_KEY=dummy dotenv -e ../../.env -- node dist/scripts/ping-qweather.js",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "db:seed": "dotenv -e ../../.env -- tsx src/db/seed.ts",
    "db:reset": "rm -f data/dev.db data/dev.db-shm data/dev.db-wal && pnpm db:migrate && pnpm db:seed",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio"
  },
  "dependencies": {
    "@koa/bodyparser": "^5.0.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^13.0.0",
    "@langchain/core": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "@travel/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.36.0",
    "jose": "^5.9.0",
    "koa": "^2.15.3",
    "koa-pino-logger": "^4.0.0",
    "langchain": "^1.0.0",
    "nanoid": "^5.0.0",
    "pino": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.0",
    "@types/koa__router": "^12.0.4",
    "@types/node": "^24.0.0",
    "dotenv-cli": "^7.4.2",
    "drizzle-kit": "^0.28.0",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
